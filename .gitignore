# カード明細の元CSV（個人情報：口座番号・名義人を含むため絶対にコミットしない）
imports/*.csv

# 給与明細の原本PDF（氏名・社員番号を含む）
# 取り込み済みの数値は data/incomes.json に入っており、そちらはコミットされる。
# 原本もバックアップしたい場合はこの2行を消してよい（リポジトリがプライベートであること）
給与明細/*.pdf

# ビルド成果物（家計データを平文で埋め込んだ単一HTML。ローカル閲覧用）
dist/

# 家計データそのもの（コードのみを管理する方針のため除外）
# ※ この設定ではリポジトリはバックアップにならない。data/ は各自でバックアップすること
data/

# GitHub Pages 用ダッシュボードの合言葉。絶対にコミットしない
.webpass

# 秘密情報
.env
.env.local
*.key
*.pem

# Node
node_modules/
npm-debug.log*

# OS
Thumbs.db
Desktop.ini
.DS_Store

# ツールの検証用一時ファイル
.playwright-mcp/
